# Python backend secrets (read by tag_cards.py / nli_tagger.py / embedding_tagger.py
# via python-dotenv, which walks up from the script's CWD).
#
# Only needed locally — the backend scripts run on your dev machine to generate
# backend/cards.json, which is then committed and shipped statically.
# NEVER set this in Vercel.

HF_TOKEN=hf_your_token_here
