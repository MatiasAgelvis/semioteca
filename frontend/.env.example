# Public env (safe in client JS)
PUBLIC_STATIC_FORMS_KEY=your_staticforms_key_here

# Server-only (NEVER prefix with PUBLIC_ — read via $env/dynamic/private in src/routes/api)
# Get values from Vercel: `cd frontend && vercel env pull .env.local`
# Or use a local file-based SQLite for dev: TURSO_DATABASE_URL=file:./.turso/local.db
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token
