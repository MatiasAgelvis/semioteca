{
  "name": "semioteca-root",
  "private": true,
  "version": "1.2.2",
  "scripts": {
    "content:generate": "cd backend && sh ../scripts/venv-python.sh generate_cards_json.py --report-anomalies",
    "content:relations": "cd backend && sh ../scripts/venv-python.sh generate_card_relations.py",
    "content:tag": "cd backend && sh ../scripts/venv-python.sh tag_cards.py",
    "content:tagstats": "cd backend && sh ../scripts/venv-python.sh tag_stats.py --per-source",
    "content:sync": "node ./scripts/sync-content.mjs",
    "content:build": "npm run content:generate && npm run content:tag && npm run content:relations && npm run content:sync",
    "content:commit-update": "git commit -m \"chore(cards): update tags and relations\" -m \"- remove outdated tags from some card entries\" -m \"- recalculate card similarity scores and relations\"",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:check": "npm --prefix frontend run check",
    "frontend:build": "npm --prefix frontend run build",
    "build": "npm run frontend:build"
  },
  "devDependencies": {
    "prettier": "^3.8.4",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.0"
  }
}
